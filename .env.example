# ---------------------------------------------------------------------------
# JobPilot environment configuration
# Copy this file to `.env.local` for local development, or set these as
# environment variables in your Vercel project settings for production.
# ---------------------------------------------------------------------------

# Base URL of the Ollama server that hosts the model.
#
# IMPORTANT: In the ai-audio-support setup, Ollama runs on the Oracle VM bound
# to localhost (http://127.0.0.1:11434) and is NEVER exposed to the internet.
#
# When JobPilot runs on Vercel (serverless, elsewhere on the internet) it
# cannot reach that localhost. You have two options:
#   1. Run JobPilot on the SAME Oracle VM  -> use http://127.0.0.1:11434
#   2. Deploy JobPilot on Vercel           -> expose the model through a
#      TLS reverse proxy (Caddy/Nginx/Cloudflare Tunnel) with an auth token,
#      and point OLLAMA_BASE_URL at that HTTPS URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The model tag to use. Must already be pulled on the Ollama server
# (e.g. `ollama pull qwen2.5:3b`).
OLLAMA_MODEL=qwen2.5:3b

# How long (ms) to wait on the model before giving up. CPU inference is slow.
OLLAMA_TIMEOUT_MS=120000

# Sampling temperature. Lower = more consistent/deterministic scoring.
OLLAMA_TEMPERATURE=0.2

# Optional bearer token sent as `Authorization: Bearer <token>` to the Ollama
# endpoint. Leave blank when talking to a localhost Ollama (it has no auth).
# Set this when your reverse proxy in front of Ollama requires a token.
OLLAMA_AUTH_TOKEN=
